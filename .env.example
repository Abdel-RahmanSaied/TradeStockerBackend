# scripts/setup-local.sh creates .env.local with random private local credentials.
TS_MODE=PAPER
TS_BIND=127.0.0.1:8080
TS_LOCAL_DEV_TOKEN=GENERATE_LOCALLY_AT_LEAST_24_CHARACTERS
DATABASE_URL=postgres://tradestocker:GENERATE_LOCALLY@127.0.0.1:55432/tradestocker_paper?sslmode=disable

# Optional public SEC filings. Use an approved application name and contact email.
# A missing contact disables new real research jobs; paper workflow still runs.
TS_SEC_USER_AGENT=''

# Optional, for an isolated dashboard on another port (for example a test run).
# Only http://127.0.0.1:<port> or http://localhost:<port> is accepted.
# TS_DASHBOARD_ORIGIN=http://127.0.0.1:15173
