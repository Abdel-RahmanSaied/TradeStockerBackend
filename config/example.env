# Settings for scripts/dev-stack.sh (S01-T02). Copy to config/dev.env (ignored
# by Git) to change them; the defaults below apply without it. No secret goes
# here: the database password, the database URL and the API token are created
# fresh per project in .local/dev-stack/<project>/ (folder 700, files 600).

# Compose project. Must be tradestocker-dev or tradestocker-dev-<suffix>
# (lowercase letters, digits and dashes); anything else is refused.
TS_DEV_PROJECT=tradestocker-dev

# The API is published on 127.0.0.1 only. PostgreSQL and NATS are not published.
TS_DEV_API_PORT=18280

# The dashboard origin platform-core accepts (the frontend dev server port).
TS_DEV_FRONTEND_PORT=15273

# Fixed for this stack and not settable here: PAPER mode only, no SEC contact,
# no market data provider, no model, no Telegram bot, no broker.
