{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.tradestocker.invalid/events/v1/market.data.quality.changed.v1.schema.json",
  "title": "market.data.quality.changed, version 1",
  "description": "A data quality revision. Entry gates are evaluated again on every change.",
  "x-tradestocker-catalog-name": "market.data.quality.changed.v1",
  "x-tradestocker-producer": "market-ingestion",
  "x-tradestocker-consumer": "platform-core and operations",
  "x-tradestocker-uniqueness": "instrument_id + quality_revision",
  "x-tradestocker-runtime": "contract only: no producer emits this event yet",
  "type": "object",
  "properties": {
    "event_id": {
      "$ref": "envelope.schema.json#/properties/event_id"
    },
    "event_type": {
      "$ref": "envelope.schema.json#/properties/event_type",
      "const": "market.data.quality.changed"
    },
    "schema_version": {
      "$ref": "envelope.schema.json#/properties/schema_version"
    },
    "occurred_at": {
      "$ref": "envelope.schema.json#/properties/occurred_at"
    },
    "published_at": {
      "$ref": "envelope.schema.json#/properties/published_at"
    },
    "producer": {
      "$ref": "envelope.schema.json#/properties/producer",
      "const": "market-ingestion"
    },
    "producer_build": {
      "$ref": "envelope.schema.json#/properties/producer_build"
    },
    "correlation_id": {
      "$ref": "envelope.schema.json#/properties/correlation_id"
    },
    "causation_id": {
      "$ref": "envelope.schema.json#/properties/causation_id"
    },
    "mode": {
      "$ref": "envelope.schema.json#/properties/mode"
    },
    "account_id": {
      "$ref": "envelope.schema.json#/properties/account_id"
    },
    "data": {
      "$ref": "#/$defs/data"
    }
  },
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "occurred_at",
    "published_at",
    "producer",
    "producer_build",
    "correlation_id",
    "causation_id",
    "mode",
    "account_id",
    "data"
  ],
  "additionalProperties": false,
  "$defs": {
    "data": {
      "type": "object",
      "properties": {
        "instrument_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "quality": {
          "type": "string",
          "enum": [
            "OK",
            "DEGRADED",
            "STALE",
            "MISSING",
            "UNVERIFIED"
          ]
        },
        "quality_revision": {
          "$ref": "common.schema.json#/$defs/revision"
        },
        "effective_from": {
          "$ref": "common.schema.json#/$defs/utc_timestamp"
        },
        "reason_codes": {
          "$ref": "common.schema.json#/$defs/codes"
        }
      },
      "required": [
        "instrument_id",
        "quality",
        "quality_revision",
        "effective_from",
        "reason_codes"
      ],
      "additionalProperties": false
    }
  }
}
