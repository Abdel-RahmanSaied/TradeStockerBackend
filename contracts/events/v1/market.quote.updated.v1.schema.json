{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.tradestocker.invalid/events/v1/market.quote.updated.v1.schema.json",
  "title": "market.quote.updated, version 1",
  "description": "A quote observation. Missing sides are null, never zero.",
  "x-tradestocker-catalog-name": "market.quote.updated.v1",
  "x-tradestocker-producer": "market-ingestion",
  "x-tradestocker-consumer": "intraday screening and data quality",
  "x-tradestocker-uniqueness": "provider_id + instrument_id + source_sequence; a duplicate is harmless",
  "x-tradestocker-runtime": "contract only: no producer emits this event yet",
  "type": "object",
  "properties": {
    "event_id": {
      "$ref": "envelope.schema.json#/properties/event_id"
    },
    "event_type": {
      "$ref": "envelope.schema.json#/properties/event_type",
      "const": "market.quote.updated"
    },
    "schema_version": {
      "$ref": "envelope.schema.json#/properties/schema_version"
    },
    "occurred_at": {
      "$ref": "envelope.schema.json#/properties/occurred_at"
    },
    "published_at": {
      "$ref": "envelope.schema.json#/properties/published_at"
    },
    "producer": {
      "$ref": "envelope.schema.json#/properties/producer",
      "const": "market-ingestion"
    },
    "producer_build": {
      "$ref": "envelope.schema.json#/properties/producer_build"
    },
    "correlation_id": {
      "$ref": "envelope.schema.json#/properties/correlation_id"
    },
    "causation_id": {
      "$ref": "envelope.schema.json#/properties/causation_id"
    },
    "mode": {
      "$ref": "envelope.schema.json#/properties/mode"
    },
    "account_id": {
      "$ref": "envelope.schema.json#/properties/account_id"
    },
    "data": {
      "$ref": "#/$defs/data"
    }
  },
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "occurred_at",
    "published_at",
    "producer",
    "producer_build",
    "correlation_id",
    "causation_id",
    "mode",
    "account_id",
    "data"
  ],
  "additionalProperties": false,
  "$defs": {
    "data": {
      "type": "object",
      "properties": {
        "provider_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "instrument_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "source_sequence": {
          "$ref": "common.schema.json#/$defs/sequence"
        },
        "quoted_at": {
          "$ref": "common.schema.json#/$defs/utc_timestamp"
        },
        "bid": {
          "$ref": "common.schema.json#/$defs/nullable_positive_decimal"
        },
        "ask": {
          "$ref": "common.schema.json#/$defs/nullable_positive_decimal"
        },
        "last": {
          "$ref": "common.schema.json#/$defs/nullable_positive_decimal"
        },
        "currency": {
          "$ref": "common.schema.json#/$defs/currency"
        }
      },
      "required": [
        "provider_id",
        "instrument_id",
        "source_sequence",
        "quoted_at",
        "bid",
        "ask",
        "last",
        "currency"
      ],
      "additionalProperties": false
    }
  }
}
