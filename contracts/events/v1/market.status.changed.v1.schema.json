{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.tradestocker.invalid/events/v1/market.status.changed.v1.schema.json",
  "title": "market.status.changed, version 1",
  "description": "An effective-dated trading status. Advice that depends on the affected market or instrument must be invalidated.",
  "x-tradestocker-catalog-name": "market.status.changed.v1",
  "x-tradestocker-producer": "market-ingestion",
  "x-tradestocker-consumer": "platform-core and research",
  "x-tradestocker-uniqueness": "market + instrument_id + status_revision",
  "x-tradestocker-runtime": "contract only: no producer emits this event yet",
  "type": "object",
  "properties": {
    "event_id": {
      "$ref": "envelope.schema.json#/properties/event_id"
    },
    "event_type": {
      "$ref": "envelope.schema.json#/properties/event_type",
      "const": "market.status.changed"
    },
    "schema_version": {
      "$ref": "envelope.schema.json#/properties/schema_version"
    },
    "occurred_at": {
      "$ref": "envelope.schema.json#/properties/occurred_at"
    },
    "published_at": {
      "$ref": "envelope.schema.json#/properties/published_at"
    },
    "producer": {
      "$ref": "envelope.schema.json#/properties/producer",
      "const": "market-ingestion"
    },
    "producer_build": {
      "$ref": "envelope.schema.json#/properties/producer_build"
    },
    "correlation_id": {
      "$ref": "envelope.schema.json#/properties/correlation_id"
    },
    "causation_id": {
      "$ref": "envelope.schema.json#/properties/causation_id"
    },
    "mode": {
      "$ref": "envelope.schema.json#/properties/mode"
    },
    "account_id": {
      "$ref": "envelope.schema.json#/properties/account_id"
    },
    "data": {
      "$ref": "#/$defs/data"
    }
  },
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "occurred_at",
    "published_at",
    "producer",
    "producer_build",
    "correlation_id",
    "causation_id",
    "mode",
    "account_id",
    "data"
  ],
  "additionalProperties": false,
  "$defs": {
    "data": {
      "type": "object",
      "properties": {
        "market": {
          "$ref": "common.schema.json#/$defs/market"
        },
        "instrument_id": {
          "$ref": "common.schema.json#/$defs/nullable_id",
          "description": "null when the status covers the whole market."
        },
        "status": {
          "type": "string",
          "enum": [
            "PRE_OPEN",
            "OPEN",
            "CLOSED",
            "HALTED",
            "SUSPENDED"
          ]
        },
        "effective_from": {
          "$ref": "common.schema.json#/$defs/utc_timestamp"
        },
        "status_revision": {
          "$ref": "common.schema.json#/$defs/revision"
        },
        "reason_code": {
          "$ref": "common.schema.json#/$defs/code"
        }
      },
      "required": [
        "market",
        "instrument_id",
        "status",
        "effective_from",
        "status_revision",
        "reason_code"
      ],
      "additionalProperties": false
    }
  }
}
