{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.tradestocker.invalid/events/v1/recommendation.invalidated.v1.schema.json",
  "title": "recommendation.invalidated, version 1",
  "description": "A recommendation revision is no longer valid. An invalidated entry is never revived; a new revision is needed.",
  "x-tradestocker-catalog-name": "recommendation.invalidated.v1",
  "x-tradestocker-producer": "platform-core",
  "x-tradestocker-consumer": "notifications and monitoring",
  "x-tradestocker-uniqueness": "recommendation_id + revision",
  "x-tradestocker-runtime": "contract only: no producer emits this event yet",
  "type": "object",
  "properties": {
    "event_id": {
      "$ref": "envelope.schema.json#/properties/event_id"
    },
    "event_type": {
      "$ref": "envelope.schema.json#/properties/event_type",
      "const": "recommendation.invalidated"
    },
    "schema_version": {
      "$ref": "envelope.schema.json#/properties/schema_version"
    },
    "occurred_at": {
      "$ref": "envelope.schema.json#/properties/occurred_at"
    },
    "published_at": {
      "$ref": "envelope.schema.json#/properties/published_at"
    },
    "producer": {
      "$ref": "envelope.schema.json#/properties/producer",
      "const": "platform-core"
    },
    "producer_build": {
      "$ref": "envelope.schema.json#/properties/producer_build"
    },
    "correlation_id": {
      "$ref": "envelope.schema.json#/properties/correlation_id"
    },
    "causation_id": {
      "$ref": "envelope.schema.json#/properties/causation_id"
    },
    "mode": {
      "$ref": "envelope.schema.json#/properties/mode"
    },
    "account_id": {
      "$ref": "envelope.schema.json#/properties/account_id"
    },
    "data": {
      "$ref": "#/$defs/data"
    }
  },
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "occurred_at",
    "published_at",
    "producer",
    "producer_build",
    "correlation_id",
    "causation_id",
    "mode",
    "account_id",
    "data"
  ],
  "additionalProperties": false,
  "$defs": {
    "data": {
      "type": "object",
      "properties": {
        "recommendation_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "revision": {
          "$ref": "common.schema.json#/$defs/revision"
        },
        "reason_code": {
          "$ref": "common.schema.json#/$defs/code"
        },
        "caused_by_event_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "invalidated_at": {
          "$ref": "common.schema.json#/$defs/utc_timestamp"
        }
      },
      "required": [
        "recommendation_id",
        "revision",
        "reason_code",
        "caused_by_event_id",
        "invalidated_at"
      ],
      "additionalProperties": false
    }
  }
}
