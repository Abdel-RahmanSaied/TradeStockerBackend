{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.tradestocker.invalid/events/v1/research.assessment.requested.v1.schema.json",
  "title": "research.assessment.requested, version 1",
  "description": "Go asks research for an assessment of one candidate over a fixed data snapshot and configuration.",
  "x-tradestocker-catalog-name": "research.assessment.requested.v1",
  "x-tradestocker-producer": "platform-core",
  "x-tradestocker-consumer": "research",
  "x-tradestocker-uniqueness": "candidate_id + snapshot_sha256 + config_sha256 + mode",
  "x-tradestocker-runtime": "contract only: no producer emits this event yet",
  "type": "object",
  "properties": {
    "event_id": {
      "$ref": "envelope.schema.json#/properties/event_id"
    },
    "event_type": {
      "$ref": "envelope.schema.json#/properties/event_type",
      "const": "research.assessment.requested"
    },
    "schema_version": {
      "$ref": "envelope.schema.json#/properties/schema_version"
    },
    "occurred_at": {
      "$ref": "envelope.schema.json#/properties/occurred_at"
    },
    "published_at": {
      "$ref": "envelope.schema.json#/properties/published_at"
    },
    "producer": {
      "$ref": "envelope.schema.json#/properties/producer",
      "const": "platform-core"
    },
    "producer_build": {
      "$ref": "envelope.schema.json#/properties/producer_build"
    },
    "correlation_id": {
      "$ref": "envelope.schema.json#/properties/correlation_id"
    },
    "causation_id": {
      "$ref": "envelope.schema.json#/properties/causation_id"
    },
    "mode": {
      "$ref": "envelope.schema.json#/properties/mode"
    },
    "account_id": {
      "$ref": "envelope.schema.json#/properties/account_id"
    },
    "data": {
      "$ref": "#/$defs/data"
    }
  },
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "occurred_at",
    "published_at",
    "producer",
    "producer_build",
    "correlation_id",
    "causation_id",
    "mode",
    "account_id",
    "data"
  ],
  "additionalProperties": false,
  "$defs": {
    "data": {
      "type": "object",
      "properties": {
        "job_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "candidate_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "instrument_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "strategy_id": {
          "$ref": "common.schema.json#/$defs/lane"
        },
        "snapshot_sha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "config_sha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "as_of": {
          "$ref": "common.schema.json#/$defs/utc_timestamp"
        },
        "deadline_at": {
          "$ref": "common.schema.json#/$defs/utc_timestamp"
        }
      },
      "required": [
        "job_id",
        "candidate_id",
        "instrument_id",
        "strategy_id",
        "snapshot_sha256",
        "config_sha256",
        "as_of",
        "deadline_at"
      ],
      "additionalProperties": false
    }
  }
}
